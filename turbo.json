{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"deploy": {
			"cache": false,
			"interactive": true
		},
		"deploy:prod": {
			"cache": false,
			"interactive": true
		},
		"destroy": {
			"cache": false,
			"interactive": true
		}
	},
	"globalEnv": [
		"APP_ENV",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"CI",
		"CORS_ORIGIN",
		"NODE_ENV",
		"POLAR_ACCESS_TOKEN",
		"POLAR_SUCCESS_URL",
		"POLAR_SERVER",
		"POLAR_PRODUCT_STADSKOT",
		"POLAR_PRODUCT_FAMILIEKOT",
		"POLAR_PRODUCT_BOERDERIJBENDE",
		"VERCEL",
		"VERCEL_ENV",
		"VERCEL_PROJECT_PRODUCTION_URL",
		"VERCEL_URL",
		"VITE_SERVER_URL",
		"_VARLOCK_ENV_KEY"
	],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
