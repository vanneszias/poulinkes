# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$APP_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Selects the .env.<APP_ENV> file. Not NODE_ENV: the alchemy CLI forces NODE_ENV=production, even for `alchemy dev`.
# @public @type=enum(development, production, test)
APP_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @type=url
POLAR_SUCCESS_URL=

# Use "sandbox" with a sandbox.polar.sh token, "production" with a live one.
# @sensitive=false @type=enum(sandbox, production)
POLAR_SERVER=sandbox

# Polar product IDs, one recurring product per plan.
# @sensitive=false
POLAR_PRODUCT_STADSKOT=

# @sensitive=false
POLAR_PRODUCT_FAMILIEKOT=

# @sensitive=false
POLAR_PRODUCT_BOERDERIJBENDE=

